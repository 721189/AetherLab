# ============================================================================
# AetherLab backend environment template -- COMPLETE configuration contract.
#
# Copy to `.env` and fill in real values. NEVER commit .env.
# Every Settings field is listed here; if a key is missing from this file,
# that is a documentation bug.
# ============================================================================

# ----------------------------------------------------------------------------
# APP
# ----------------------------------------------------------------------------
APP_NAME=AetherLab API
APP_ENV=development
# APP_ENV drives fail-safe behaviour:
#   development/testing -> graceful fallbacks (e.g. rate limiter memory storage)
#   production          -> startup FAILS when safety-critical infra (Redis) is down
DEBUG=True

# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/aetherlab

# ----------------------------------------------------------------------------
# SECURITY / AUTH
# ----------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_to_a_long_random_secret_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Set the Secure flag on auth cookies -- MUST be true behind HTTPS/production.
COOKIE_SECURE=False
# Base URL used in verification links emailed to users.
FRONTEND_BASE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# REDIS (Celery broker/backend, distributed rate limiting, provider cache)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------------
# EMAIL (verification delivery). Without RESEND_API_KEY the console provider
# is used (emails logged + captured for local testing).
# ----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=AetherLab <no-reply@aetherlab.app>

# ----------------------------------------------------------------------------
# ENVIRONMENTAL DATA PROVIDERS (optional; ingestion needs them enabled)
# ----------------------------------------------------------------------------
OPENWEATHER_API_KEY=your-openweather-api-key
OPENAQ_API_KEY=your-openaq-api-key

# NASA POWER -- meteorological reanalysis (MERRA-2). No API key required.

# Copernicus Data Space Ecosystem. Catalogue search/metadata work without
# credentials; raster value extraction (Sentinel-5P NO2) requires an account.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ----------------------------------------------------------------------------
# PROVIDER CACHE (protects paid APIs from repeated/nearby requests)
# ----------------------------------------------------------------------------
PROVIDER_CACHE_TTL_SECONDS=900

# ----------------------------------------------------------------------------
# LLM (OpenRouter hosts free Nemotron models -- preferred; OpenAI = paid fallback)
# ----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_SITE_URL=https://aetherlab.app
LLM_MODEL=nvidia/nemotron-4-340b-base
LLM_FALLBACK_MODEL=
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# CORS -- browser origins allowed to call the API (Next.js dev server)
# ----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# ----------------------------------------------------------------------------
# OBSERVABILITY -- Sentry error & performance monitoring (backend)
# ----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_RELEASE=AetherLab@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=False
