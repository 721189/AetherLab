# AetherLab backend environment template
# Copy this file to `.env` and fill in real values. NEVER commit .env.

# Application
APP_NAME=AetherLab API
APP_ENV=development
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/aetherlab

# Security — generate a long random value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`)
SECRET_KEY=change_me_to_a_long_random_secret_at_least_32_chars

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Infrastructure
REDIS_URL=redis://localhost:6379/0

# AI provider (OpenRouter hosts free Nemotron models — preferred)
# Paste your real key here and remove OPENAI_API_KEY to avoid any paid calls.
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_SITE_URL=https://aetherlab.app
# Free Nemotron model served via OpenRouter (override per-agent if needed)
LLM_MODEL=nvidia/nemotron-4-340b-base

# Environmental data providers (optional, only needed for data ingestion)
OPENWEATHER_API_KEY=your-openweather-api-key
OPENAQ_API_KEY=your-openaq-api-key
