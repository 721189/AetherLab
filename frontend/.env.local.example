# AetherLab frontend environment template.
# Copy to `.env.local` and adjust the API base URL for your environment.
# NEVER commit real `.env.local` values.

# Base URL of the AetherLab backend API (FastAPI).
# Local dev:  http://localhost:8000
# Docker run: http://host.docker.internal:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sentry (frontend observability) - get these from your Sentry project.
# NEXT_PUBLIC_* vars are exposed to the browser SDK; SENTRY_DSN/ORG/
# PROJECT/AUTH_TOKEN are for server-side capture and optional source-map
# uploads during `npm run build`.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=aetherlab-frontend
SENTRY_AUTH_TOKEN=
