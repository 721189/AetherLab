# AetherLab frontend environment template.
# Copy to `.env.local` and adjust the API base URL for your environment.
# NEVER commit real `.env.local` values.

# Base URL of the AetherLab backend API (FastAPI).
# Local dev:  http://localhost:8000
# Docker run: http://host.docker.internal:8000
NEXT_PUBLIC_API_URL=http://localhost:8000