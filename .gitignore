# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environment
.venv/
venv/

# Environment variables — never commit real secrets
.env*
!.env.example
!frontend/.env.local.example

# IDE
.vscode/
.idea/

# Alembic cache
backend/alembic/__pycache__/

# Python cache
backend/**/__pycache__/

# Logs
*.log

# Test artifacts
.pytest_cache/
backend/.pytest_cache/

# Local SQLite database (created when DATABASE_URL points at sqlite)
backend/*.db
*.db

# Node.js / Next.js
node_modules/
.next/
frontend/node_modules/
frontend/.next/

# Build output / coverage
dist/
*.egg-info/
.coverage
backend/.coverage

# Stray diagnostic / probe artifacts (generated during earlier debugging).
# They are already tracked; remove from the index with:
#   git rm --cached frontend/_dev_err.txt git_check.txt
_check.txt
backend/_diag.py
backend/_diag_out.txt
backend/_op.txt
backend/_rt.txt
frontend/_fb.txt
frontend/_dev_err.txt
git_check.txt